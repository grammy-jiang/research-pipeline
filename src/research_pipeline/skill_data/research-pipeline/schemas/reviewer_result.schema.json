{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReviewerResult",
  "description": "Schema for reviewer gate results (synthesis reviewer, rank reviewer).",
  "type": "object",
  "required": [
    "reviewer_task_id",
    "target_artifact",
    "status",
    "target_sha256",
    "scores"
  ],
  "properties": {
    "reviewer_task_id": {
      "type": "string"
    },
    "target_artifact": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected",
        "accepted_with_issues"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unsupported_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_fixes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "notes": {
      "type": "string"
    },
    "target_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scores": {
      "type": "object",
      "required": [
        "faithfulness",
        "coherence",
        "gap_completeness",
        "citation_integrity"
      ],
      "properties": {
        "faithfulness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "coherence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "gap_completeness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation_integrity": {
          "type": "boolean"
        }
      }
    }
  }
}
